# PoE2 Trade Assistant Configuration

# API Settings для PoE2
POE_API_BASE_URL=https://www.pathofexile.com/api/trade2
POE2_API_BASE_URL=https://www.pathofexile.com/api/trade2
REQUEST_DELAY=2.0
MAX_RETRIES=3

# Database
DATABASE_PATH=data/trade_data.db

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_SOUND=true
DISCORD_WEBHOOK_URL=

# UI Settings
THEME=dark
UPDATE_INTERVAL=30

# Search Filters
MAX_PRICE=100
MIN_PRICE=1
LEAGUE=Necrosis

# Debug
DEBUG=false
LOG_LEVEL=INFO