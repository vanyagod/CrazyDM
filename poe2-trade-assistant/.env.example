# PoE2 Trade Assistant Configuration

# API Settings
POE_API_BASE_URL=https://www.pathofexile.com/api/trade
POE2_API_BASE_URL=https://www.pathofexile.com/api/trade2
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Database
DATABASE_PATH=data/trade_data.db

# Notifications
ENABLE_NOTIFICATIONS=true
NOTIFICATION_SOUND=true
DISCORD_WEBHOOK_URL=

# UI Settings
THEME=dark
UPDATE_INTERVAL=30

# Search Filters
MAX_PRICE=100
MIN_PRICE=1
LEAGUE=Hardcore

# Debug
DEBUG=false
LOG_LEVEL=INFO